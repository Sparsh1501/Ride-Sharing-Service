{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Dispatch Engine Overview",
  "uid": "dispatch-engine",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Dispatch matching latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dispatch_matching_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Match result rate (matched vs no_driver)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(dispatch_match_success_rate_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Candidates evaluated per request",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(dispatch_candidates_evaluated_sum[5m]) / rate(dispatch_candidates_evaluated_count[5m])",
          "legendFormat": "avg candidates"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active WebSocket connections",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(websocket_connections_active)", "legendFormat": "active" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Surge multiplier distribution (avg)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "rate(surge_multiplier_distribution_sum[5m]) / rate(surge_multiplier_distribution_count[5m])",
          "legendFormat": "avg multiplier"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag) by (client_id)",
          "legendFormat": "{{client_id}}"
        }
      ]
    }
  ]
}
