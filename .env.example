# Copy to .env and adjust as needed. docker-compose reads this file automatically.

# Postgres
POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch

# Security
JWT_SECRET=dispatch-engine-dev-secret-key-please-change-1234567890

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Host port for ride-request-service (override if 8081 is taken on your machine)
RIDE_REQUEST_PORT=8081
